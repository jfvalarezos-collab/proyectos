PORT=3001
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
ADMIN_USER=admin
# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('tu-clave', 10))"
ADMIN_PASSWORD_HASH=12345

# Solo necesario si LibreOffice no quedó instalado en la ruta por defecto
# (C:\Program Files\LibreOffice\program\soffice.exe). Se usa para convertir
# archivos .pptx subidos por el administrador a PDF.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Solo se usa en producción (Railway): carpeta donde vive el volumen persistente montado
# por la plataforma. Adentro se crean automáticamente data/ (SQLite) y uploads/ (archivos
# subidos). En desarrollo local, sin esta variable, se usan backend/data y backend/uploads
# como siempre.
# STORAGE_DIR=/app/backend/storage
